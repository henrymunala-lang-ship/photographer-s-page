# Public/non-secret workbook identifier. Keep server-side; do not prefix with NEXT_PUBLIC_.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Server-only OAuth credentials. Store as Vercel Sensitive environment variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Owner-only Google OAuth bootstrap. Preview + integration-foundation only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_OWNER_EMAIL=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_SETUP_KEY=
# Add the returned refresh token directly in Vercel as a Secret; never commit it.
GOOGLE_OAUTH_REFRESH_TOKEN=
